define MIN_TEMP 280 # 7C
define MAX_TEMP 313 # 40C
define MIN_PRESSURE 40
define MAX_PRESSURE 150

alias dSuit db
alias dHelmet d0
alias rHelmetOpen r10
alias rExternal r9
alias rReturn r8

# set initial state
s db SoundAlert 0
main:
  yield
  l rHelmetOpen dHelmet Open
  jal helmetCheck
  j main

helmetCheck:
    move rReturn ra
    jal checkSafe
    beqz rHelmetOpen checkClosedHelmet
    checkOpenedHelmet:
        #s db SoundAlert 1
        bnez r1 rReturn
        s dHelmet Open 0
        j rReturn
    checkClosedHelmet:
        #s db SoundAlert 1
        beqz r1 rReturn
        sleep 5
        jal checkSafe
        beqz r1 rReturn
        s dHelmet Open 1
        j rReturn

# r1 = 1 when the outside pressure and temperature are safe for an open helmet
checkSafe:
    l rExternal dSuit PressureExternal
    l r2 dSuit TemperatureExternal
    sgt r1 rExternal MIN_PRESSURE
    slt r3 rExternal MAX_PRESSURE
    and r1 r1 r3
    sgt r3 r2 MIN_TEMP
    and r1 r1 r3
    slt r3 r2 MAX_TEMP
    and r1 r1 r3
    j ra