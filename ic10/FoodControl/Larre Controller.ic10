# Larre Controller: walks a hydroponics Larre along its stations, harvests each mature
# plant, takes the crop to DropOff and replants the seeds. d0: the Larre dock.
# db Setting: the station it's checking.
alias larre d0
alias counter r10
define DropOff 15 # Change this number to the station where you have the input chute
define PlantClass 11
define HARVEST_TRIES 5 # Activates before giving up on a plant


reset:
move counter 0

start:
  ls r0 larre 0 Occupied
  beqz r0 check
  s larre Setting DropOff
  jal waitlarre
  s larre Activate 1
  jal waitlarre
  j start

check:
  add counter counter 1
  breq counter DropOff -1
  s larre Setting counter
  jal waitlarre
  l r0 larre Setting
  bne r0 counter reset
  s db Setting r0
  beqz r0 reset

checkplant:
  ls r0 larre 255 Class
  bne r0 PlantClass start
  ls r0 larre 255 Mature
  beqz r0 start
  ls r0 larre 255 Seeding
  beq r0 -1 start
  jal held
  move r3 r0 # items in the arm before this visit
  move r2 HARVEST_TRIES

harvest:
  s larre Activate 1
  jal waitlarre
  ls r0 larre 255 Occupied
  seqz r0 r0
  ls r1 larre 255 Seeding
  seq r1 r1 -1
  or r0 r0 r1
  sub r2 r2 1
  sle r1 r2 0 # out of tries: drop off whatever we have
  or r0 r0 r1
  beqz r0 harvest

  jal held
  move r4 r0 # items in the arm after it
  s larre Setting DropOff
  jal waitlarre
  s larre Activate 1
  jal waitlarre
  s larre Setting counter
  jal waitlarre
  ls r0 larre 255 Occupied
  beqz r0 replant
  bgt r4 r3 checkplant # still there and this visit took some: go back for the rest
  j start

replant:
  s larre Activate 1
  jal waitlarre
  j start

held: # r0 = items in the arm's two slots
  ls r0 larre 0 Quantity
  ls r1 larre 1 Quantity
  add r0 r0 r1
  j ra

waitlarre:
  yield
  l r0 larre Idle
  breqz r0 -2
  j ra