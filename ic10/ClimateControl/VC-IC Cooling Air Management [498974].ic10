alias ExpelGasExchangeVent d0
define MAX_PIPE_TEMP 419.15 # 146C
define MIN_PRESSURE 500
loop:
yield
jal expelVentCheck
sleep 5
j loop

expelVentCheck:
l r0 ExpelGasExchangeVent TemperatureOutput
l r1 ExpelGasExchangeVent PressureOutput # the pipe's pressure (PressureInternal is the vent's limit setting)
sgt r2 r0 MAX_PIPE_TEMP
sgt r3 r1 MIN_PRESSURE # keep at least MIN_PRESSURE in the pipe
min r2 r2 r3 

s ExpelGasExchangeVent Mode 0
s ExpelGasExchangeVent On r2
j ra