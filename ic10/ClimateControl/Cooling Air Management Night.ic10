# Night air: at night fill a pipe with cold outside air, by day expel it once it's hot.
# d0: active vent on the pipe. d1: gas sensor outside. db Setting: the pipe's temperature.
alias Vent d0
alias Sensor d1

alias OutsideTemp r0
alias PipeTemp r1
alias PipePressure r2

define MAX_TEMP_IN_PIPE 453 #180C
define NIGHT_TEMP_MAX 408 #127C
define PIPE_MAX_PRESSURE 41000

start:
yield
l PipeTemp Vent TemperatureOutput
l PipePressure Vent PressureOutput
s db Setting PipeTemp
bdns Sensor ventOff
l OutsideTemp Sensor Temperature
jal ventControl
j start

ventControl:
  ble OutsideTemp NIGHT_TEMP_MAX nightTempMode
  bgt OutsideTemp NIGHT_TEMP_MAX dayTempMode
  ventOff: # no reading (NaN, or no sensor): leave the pipe alone
    s Vent On 0
    j start
  nightTempMode:
    s Vent Mode 1
    yield
    slt r3 PipePressure PIPE_MAX_PRESSURE
    s Vent On r3
    j ra
  dayTempMode:
    sgt r3 PipeTemp MAX_TEMP_IN_PIPE
    s Vent Mode 0
    yield
    s Vent On r3
    j ra
