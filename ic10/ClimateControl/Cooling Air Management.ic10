# Cooling Air Management: expels a hot gas pipe (over 146 C) through an active vent,
# keeping about 500 kPa in it. d0: the vent.
alias ExpelGasExchangeVent d0
define MAX_PIPE_TEMP 419.15 # 146C
define MIN_PRESSURE 500 # rough floor: the vent can run below it between checks (sleep 5)
loop:
yield
jal expelVentCheck
sleep 5
j loop

expelVentCheck:
l r0 ExpelGasExchangeVent TemperatureOutput
l r1 ExpelGasExchangeVent PressureOutput # the pipe's (PressureInternal is a setting)
sgt r2 r0 MAX_PIPE_TEMP
sgt r3 r1 MIN_PRESSURE # keep at least MIN_PRESSURE in the pipe
min r2 r2 r3

s ExpelGasExchangeVent Mode 0
s ExpelGasExchangeVent On r2
j ra
