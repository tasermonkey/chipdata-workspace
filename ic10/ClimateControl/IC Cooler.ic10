# Alaska was the name of the save for a Europa run
# This IC cools our 'waste' gases from power generation, ore smelting, etc.
# We needed CO2. But the CO2 was HOT. So, Europa being cold, we made a pipe system that
# passes it through radiators (the pipe ones, and at some point the medium radiators).
# This watches the CO2's temperature and keeps it within a range (MIN/MAX TEMP): it
# sucks in cold air from outside until the CO2 is below MIN_TEMP, then turns the vent
# off until the CO2 gets above MAX_TEMP.
# Required Hardware:
#  - 1x Pipe Analyzer (PA_SRC/d0) - measures the temperature of the gas being cooled
#  - 1x Pipe Analyzer (PA_ATMO/d1) - measures the outside air in the coolant pipe
#    (I didn't realize at the time that vents can measure the pipe themselves)
#  - 1x Vent (VP_ATMO/d2) - brings in cold air from outside to cool the PA_SRC pipe

alias PA_SRC d0
alias PA_ATMO d1
alias VP_ATMO d2

define MIN_TEMP 290 # 17C
define MAX_TEMP 303 # 30C
define EMPTY_KPA 1 # stage 0 counts the outside-air pipe empty at or below this

alias Stage r15 

start:
yield
l r0 PA_SRC Temperature
beqz Stage stopCooling
beq Stage 1 waitForWarm
beq Stage 2 startCooling
j start

stopCooling: # empty the coolant pipe outside so it can't freeze under pressure
l r0 PA_ATMO Pressure
ble r0 EMPTY_KPA doneStopping
s VP_ATMO Mode 0 # Outward: pipe to outside
yield
s VP_ATMO On 1
j start

doneStopping:
move Stage 1
s VP_ATMO Mode 0
yield
s VP_ATMO On 0
sleep 5
j start

waitForWarm:
sleep 2
blt r0 MAX_TEMP start
move Stage 2

startCooling:
blt r0 MIN_TEMP finishCooling
s VP_ATMO Mode 1 # Inward: outside air into the pipe
yield
s VP_ATMO On 1
j start

finishCooling:
move Stage 0
j start
