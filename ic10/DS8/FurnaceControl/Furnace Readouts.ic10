# Furnace Readouts: temperature and pressure, in the furnace and its box.
# DS-8 rack, socket 9. Owns the four readouts. Each can be a display,
# or a gauge: Gauge2x2, Gauge3x3 or EdgewiseMeter3.
define FURNACE_PORT 4128 # port 1: Advanced Furnace
define SENSOR_PORT 4171  # port 20: Gas Sensor, in the box
define FURNACE_K_PORT 4172 # port 21: readout, furnace temperature
define FURNACE_KPA_PORT 4173 # port 22: readout, furnace pressure
define BOX_K_PORT 4174   # port 23: readout, box temperature
define BOX_KPA_PORT 4175 # port 24: readout, box pressure

define FURNACE_K_MAX 3000 # gauge scales, from 0
define FURNACE_KPA_MAX 60000
define BOX_K_MAX 600
define BOX_KPA_MAX 200
define KELVIN 3          # display modes
define PASCAL 14

alias furnace r15
alias sensor r14

main:
yield
jal ports

# Each: r1 the value, r2 a display's mode, r3 a gauge's top
ld r1 furnace Temperature
move r2 KELVIN
move r3 FURNACE_K_MAX
get r0 db FURNACE_K_PORT
jal show
ld r1 furnace Pressure
move r2 PASCAL
move r3 FURNACE_KPA_MAX
get r0 db FURNACE_KPA_PORT
jal show
ld r1 sensor Temperature
move r2 KELVIN
move r3 BOX_K_MAX
get r0 db BOX_K_PORT
jal show
ld r1 sensor Pressure
move r2 PASCAL
move r3 BOX_KPA_MAX
get r0 db BOX_KPA_PORT
jal show
j main

show:                    # r0: a readout, to show r1 on
sd r0 On 1
ld r4 r0 PrefabHash
seq r5 r4 HASH("ModularDeviceGauge2x2")
seq r6 r4 HASH("ModularDeviceGauge3x3")
or r5 r5 r6
seq r6 r4 HASH("ModularDeviceEdgewiseMeter3")
or r5 r5 r6
bnez r5 gauge
sd r0 Mode r2
seq r5 r2 PASCAL         # a display shows pascals, from kPa
select r5 r5 1000 1
mul r1 r1 r5
sd r0 Setting r1
j r17                    # ra: a rack chip has no name for it
gauge:
sd r0 Minimum 0
sd r0 Maximum r3
sd r0 Setting r1
j r17                    # ra: a rack chip has no name for it

ports:                   # back once each port has its device
get furnace db FURNACE_PORT
beqz furnace portsWait
get sensor db SENSOR_PORT
beqz sensor portsWait
move r0 FURNACE_K_PORT   # ports 21 to 24 sit together
portsNext:
get r1 db r0
beqz r1 portsWait
add r0 r0 1
ble r0 BOX_KPA_PORT portsNext
j r17                    # ra: a rack chip has no name for it
portsWait:
yield
j ports
