#put Memory 41 $0 # Power input
#put Memory 42 $0 # Input amount (unused)
#put Memory 43 $0 # Input stack toggle
#put Memory 44 $0 # Plus 10 button
#put Memory 45 $0 # Minus 10 button
#put Memory 46 $0 # Input amount
