{
	"name": "ic10-test-vscode",
	"displayName": "IC10 Test Debugger",
	"description": "Step through Stationeers IC10 scripts while their @tasermonkey/ic10-test tests run",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"publisher": "tasermonkey",
	"license": "AGPL-3.0-or-later",
	"homepage": "https://github.com/tasermonkey/chipdata-workspace/tree/main/ic10-test-vscode#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/tasermonkey/chipdata-workspace.git",
		"directory": "ic10-test-vscode"
	},
	"bugs": {
		"url": "https://github.com/tasermonkey/chipdata-workspace/issues"
	},
	"categories": [
		"Debuggers",
		"Testing"
	],
	"keywords": [
		"stationeers",
		"ic10",
		"vitest"
	],
	"engines": {
		"vscode": "^1.100.0",
		"node": ">=24"
	},
	"main": "./dist/extension.cjs",
	"activationEvents": [
		"onDebugResolve:ic10-test",
		"onDebugDynamicConfigurations:ic10-test",
		"workspaceContains:**/*.ic10",
		"workspaceContains:node_modules/@tasermonkey/ic10-test/package.json"
	],
	"contributes": {
		"languages": [
			{
				"id": "ic10",
				"aliases": [
					"IC10"
				],
				"extensions": [
					".ic10"
				]
			}
		],
		"breakpoints": [
			{
				"language": "ic10"
			}
		],
		"commands": [
			{
				"command": "ic10-test.debugTestAtCursor",
				"title": "Debug IC10 in the Test at the Cursor",
				"category": "IC10 Test"
			},
			{
				"command": "ic10-test.debugTest",
				"title": "Debug IC10 in a Test",
				"category": "IC10 Test"
			},
			{
				"command": "ic10-test.stepTick",
				"title": "Step Tick",
				"category": "IC10 Test",
				"icon": "$(watch)",
				"enablement": "debugType == 'ic10-test' && debugState == 'stopped'"
			},
			{
				"command": "ic10-test.runTicks",
				"title": "Run N Ticks…",
				"category": "IC10 Test",
				"icon": "$(run-all)",
				"enablement": "debugType == 'ic10-test' && debugState == 'stopped'"
			},
			{
				"command": "ic10-test.runUntilEvent",
				"title": "Run Until Event…",
				"category": "IC10 Test",
				"icon": "$(bell)",
				"enablement": "debugType == 'ic10-test' && debugState == 'stopped'"
			}
		],
		"menus": {
			"debug/toolBar": [
				{
					"command": "ic10-test.stepTick",
					"when": "debugType == 'ic10-test'",
					"group": "navigation@10"
				},
				{
					"command": "ic10-test.runTicks",
					"when": "debugType == 'ic10-test'",
					"group": "navigation@11"
				},
				{
					"command": "ic10-test.runUntilEvent",
					"when": "debugType == 'ic10-test'",
					"group": "navigation@12"
				}
			],
			"commandPalette": [
				{
					"command": "ic10-test.stepTick",
					"when": "debugType == 'ic10-test'"
				},
				{
					"command": "ic10-test.runTicks",
					"when": "debugType == 'ic10-test'"
				},
				{
					"command": "ic10-test.runUntilEvent",
					"when": "debugType == 'ic10-test'"
				},
				{
					"command": "ic10-test.debugTestAtCursor",
					"when": "ic10-test.inWorkspace && editorLangId =~ /^(typescript|javascript)$/"
				},
				{
					"command": "ic10-test.debugTest",
					"when": "false"
				}
			]
		},
		"configuration": {
			"title": "IC10 Test",
			"properties": {
				"ic10-test.codeLens": {
					"type": "boolean",
					"default": true,
					"description": "Show \"▶ Debug IC10\" above each it, test and describe in test files, in a workspace with .ic10 files or @tasermonkey/ic10-test installed."
				},
				"ic10-test.debugTypeScript": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"description": "Debug the test's TypeScript too: run Vitest under VS Code's JavaScript debugger, so breakpoints in .ts files stop as well as those in .ic10 scripts. Applies to the CodeLens, the cursor command, F5, and launch configurations that don't set \"debugTypeScript\" themselves. Starting takes a second or two longer."
				}
			}
		},
		"debuggers": [
			{
				"type": "ic10-test",
				"label": "IC10 Test",
				"languages": [
					"ic10"
				],
				"configurationAttributes": {
					"launch": {
						"required": [
							"test"
						],
						"properties": {
							"test": {
								"type": "string",
								"description": "The test file to run.",
								"default": "${file}"
							},
							"line": {
								"type": "number",
								"description": "The line of the it(...) or describe(...) to run alone. Leave it out to run the whole file."
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Stop before the first line any chip runs.",
								"default": false
							},
							"debugTypeScript": {
								"type": "boolean",
								"description": "Run Vitest under VS Code's JavaScript debugger too, so breakpoints in the test's TypeScript stop as well. Default: the ic10-test.debugTypeScript setting.",
								"default": true
							},
							"cwd": {
								"type": "string",
								"description": "Where to run Vitest (the folder with its config). Default: the nearest one above the test."
							},
							"runtimeExecutable": {
								"type": "string",
								"description": "The Node.js (24 or later) to run Vitest with.",
								"default": "node"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "More arguments for `vitest run`."
							},
							"env": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"description": "Environment variables for the test process."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ic10-test",
						"request": "launch",
						"name": "Debug IC10 in the current test file",
						"test": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "IC10 Test: Debug a test",
						"description": "Run one Vitest test and step through its IC10 scripts",
						"body": {
							"type": "ic10-test",
							"request": "launch",
							"name": "Debug IC10 in ${1:a test}",
							"test": "^\"\\${workspaceFolder}/${2:tests/x.test.ts}\"",
							"line": 1
						}
					}
				]
			}
		]
	},
	"scripts": {
		"build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.cjs",
		"vscode:package": "npm run build && vsce package --no-dependencies --out dist/ic10-test-vscode.vsix"
	},
	"dependencies": {
		"@vscode/debugadapter": "^1.68.0",
		"@vscode/debugprotocol": "^1.68.0"
	},
	"devDependencies": {
		"@tasermonkey/ic10-test": "*",
		"@types/vscode": "~1.100.0",
		"@vscode/debugadapter-testsupport": "^1.68.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2"
	}
}
