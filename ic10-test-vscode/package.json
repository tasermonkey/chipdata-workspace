{
	"name": "ic10-bench",
	"displayName": "IC10 Bench",
	"description": "Step through Stationeers IC10 scripts while their @tasermonkey/ic10-bench tests run",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"publisher": "tasermonkey",
	"license": "AGPL-3.0-or-later",
	"homepage": "https://github.com/tasermonkey/chipdata-workspace/tree/main/ic10-test-vscode#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/tasermonkey/chipdata-workspace.git",
		"directory": "ic10-test-vscode"
	},
	"bugs": {
		"url": "https://github.com/tasermonkey/chipdata-workspace/issues"
	},
	"categories": [
		"Debuggers",
		"Testing"
	],
	"keywords": [
		"stationeers",
		"ic10",
		"vitest"
	],
	"engines": {
		"vscode": "^1.100.0",
		"node": ">=24"
	},
	"main": "./dist/extension.cjs",
	"activationEvents": [
		"onDebugResolve:ic10-bench",
		"onDebugDynamicConfigurations:ic10-bench",
		"workspaceContains:**/*.ic10",
		"workspaceContains:node_modules/@tasermonkey/ic10-bench/package.json"
	],
	"contributes": {
		"languages": [
			{
				"id": "ic10",
				"aliases": [
					"IC10"
				],
				"extensions": [
					".ic10"
				]
			}
		],
		"breakpoints": [
			{
				"language": "ic10"
			}
		],
		"commands": [
			{
				"command": "ic10-bench.debugTestAtCursor",
				"title": "Debug IC10 in the Test at the Cursor",
				"category": "IC10 Bench"
			},
			{
				"command": "ic10-bench.debugTest",
				"title": "Debug IC10 in a Test",
				"category": "IC10 Bench"
			},
			{
				"command": "ic10-bench.debugScenario",
				"title": "Debug IC10 Scenario",
				"category": "IC10 Bench",
				"icon": "$(debug-alt)"
			},
			{
				"command": "ic10-bench.stepTick",
				"title": "Step Tick",
				"category": "IC10 Bench",
				"icon": "$(watch)",
				"enablement": "debugType == 'ic10-bench' && debugState == 'stopped'"
			},
			{
				"command": "ic10-bench.runTicks",
				"title": "Run N Ticks…",
				"category": "IC10 Bench",
				"icon": "$(run-all)",
				"enablement": "debugType == 'ic10-bench' && debugState == 'stopped'"
			},
			{
				"command": "ic10-bench.runUntilEvent",
				"title": "Run Until Event…",
				"category": "IC10 Bench",
				"icon": "$(bell)",
				"enablement": "debugType == 'ic10-bench' && debugState == 'stopped'"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "ic10-bench.debugScenario",
					"when": "ic10-bench.scenarioFile && !inDebugMode",
					"group": "navigation"
				}
			],
			"debug/toolBar": [
				{
					"command": "ic10-bench.stepTick",
					"when": "debugType == 'ic10-bench'",
					"group": "navigation@10"
				},
				{
					"command": "ic10-bench.runTicks",
					"when": "debugType == 'ic10-bench'",
					"group": "navigation@11"
				},
				{
					"command": "ic10-bench.runUntilEvent",
					"when": "debugType == 'ic10-bench'",
					"group": "navigation@12"
				}
			],
			"commandPalette": [
				{
					"command": "ic10-bench.stepTick",
					"when": "debugType == 'ic10-bench'"
				},
				{
					"command": "ic10-bench.runTicks",
					"when": "debugType == 'ic10-bench'"
				},
				{
					"command": "ic10-bench.runUntilEvent",
					"when": "debugType == 'ic10-bench'"
				},
				{
					"command": "ic10-bench.debugTestAtCursor",
					"when": "ic10-bench.inWorkspace && editorLangId =~ /^(typescript|javascript)$/"
				},
				{
					"command": "ic10-bench.debugTest",
					"when": "false"
				},
				{
					"command": "ic10-bench.debugScenario",
					"when": "ic10-bench.scenarioFile"
				}
			]
		},
		"configuration": {
			"title": "IC10 Bench",
			"properties": {
				"ic10-bench.codeLens": {
					"type": "boolean",
					"default": true,
					"description": "Show \"▶ Debug IC10\" above each it, test and describe in test files, in a workspace with .ic10 files or @tasermonkey/ic10-bench installed."
				},
				"ic10-bench.debugTypeScript": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"description": "Debug the test's TypeScript too: run Vitest under VS Code's JavaScript debugger, so breakpoints in .ts files stop as well as those in .ic10 scripts. Applies to the CodeLens, the cursor command, F5, and launch configurations that don't set \"debugTypeScript\" themselves. Starting takes a second or two longer."
				}
			}
		},
		"debuggers": [
			{
				"type": "ic10-bench",
				"label": "IC10 Bench",
				"languages": [
					"ic10"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"test": {
								"type": "string",
								"description": "The test file to run. Give this or \"scenario\".",
								"default": "${file}"
							},
							"line": {
								"type": "number",
								"description": "The line of the it(...) or describe(...) to run alone. Leave it out to run the whole file."
							},
							"scenario": {
								"type": "string",
								"description": "A world to run with no test: a world module (x.world.ts, whose default export builds and returns the world) or env JSON. It runs as fast as it can until every chip has stopped and no events are due, or until you stop it."
							},
							"program": {
								"type": "string",
								"description": "For an env JSON scenario: the .ic10 file a chip runs instead of the env's code, so breakpoints in it work."
							},
							"chip": {
								"type": "string",
								"description": "The housing (its name in the env, or $hex ID) whose chip runs \"program\". Default: the only one."
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Stop before the first line any chip runs.",
								"default": false
							},
							"debugTypeScript": {
								"type": "boolean",
								"description": "Run Vitest under VS Code's JavaScript debugger too, so breakpoints in the test's TypeScript stop as well. Default: the ic10-bench.debugTypeScript setting.",
								"default": true
							},
							"cwd": {
								"type": "string",
								"description": "Where to run Vitest (the folder with its config). Default: the nearest one above the test."
							},
							"runtimeExecutable": {
								"type": "string",
								"description": "The Node.js (24 or later) to run Vitest with.",
								"default": "node"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "More arguments for `vitest run`."
							},
							"env": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"description": "Environment variables for the test process."
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "ic10-bench",
						"request": "launch",
						"name": "Debug IC10 in the current test file",
						"test": "${file}"
					}
				],
				"configurationSnippets": [
					{
						"label": "IC10 Bench: Debug a test",
						"description": "Run one Vitest test and step through its IC10 scripts",
						"body": {
							"type": "ic10-bench",
							"request": "launch",
							"name": "Debug IC10 in ${1:a test}",
							"test": "^\"\\${workspaceFolder}/${2:tests/x.test.ts}\"",
							"line": 1
						}
					},
					{
						"label": "IC10 Bench: Debug a scenario",
						"description": "Run a world module (or env JSON) with no test and step through its IC10 scripts",
						"body": {
							"type": "ic10-bench",
							"request": "launch",
							"name": "Debug IC10 scenario ${1:x}",
							"scenario": "^\"\\${workspaceFolder}/${2:x.world.ts}\""
						}
					}
				]
			}
		]
	},
	"scripts": {
		"build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.cjs",
		"vscode:package": "npm run build && vsce package --no-dependencies --out dist/ic10-bench.vsix"
	},
	"dependencies": {
		"@vscode/debugadapter": "^1.68.0",
		"@vscode/debugprotocol": "^1.68.0"
	},
	"devDependencies": {
		"@tasermonkey/ic10-bench": "*",
		"@types/vscode": "~1.100.0",
		"@vscode/debugadapter-testsupport": "^1.68.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2"
	}
}
