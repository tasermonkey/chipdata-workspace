{
	"name": "@tasermonkey/ic10-test",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Test harness for Stationeers IC10 scripts, built on the @tasermonkey/ic10 emulator (a fork of @stationeers-ic/ic10)",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/tasermonkey/chipdata-workspace.git",
		"directory": "ic10-test"
	},
	"bin": {
		"ic10-test": "./bin/ic10-test.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./vitest": "./src/matchers/vitest-setup.ts",
		"./debug-protocol": "./src/debug/protocol.ts",
		"./run-scenario": "./src/debug/run-scenario.ts"
	},
	"scripts": {
		"catalog:build": "node --conditions=source tools/catalog-build.ts",
		"pretest": "npm run catalog:build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@tasermonkey/ic10": "^1.0.0"
	},
	"engines": {
		"node": ">=24"
	},
	"peerDependencies": {
		"vitest": ">=5"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"vitest": "^5.0.3"
	}
}
