{
	"name": "chipdata-workspace",
	"private": true,
	"type": "module",
	"description": "Stationeers IC10 scripts and their tests",
	"scripts": {
		"catalog": "ic10-bench catalog",
		"import-mods": "ic10-bench import-mods",
		"lint": "ic10-bench lint",
		"pretest": "npm run catalog",
		"test": "vitest run",
		"test:watch": "vitest",
		"pretypecheck": "npm run catalog",
		"typecheck": "tsc -p tsconfig.json",
		"ic-link": "ic10-link watch",
		"ic-link:status": "ic10-link status"
	},
	"devDependencies": {
		"@tasermonkey/ic10": "^1.0.1",
		"@tasermonkey/ic10-bench": "file:../ic10-bench/packages/ic10-bench",
		"@tasermonkey/ic10-link": "file:../ic10-bench/packages/ic10-link",
		"@tasermonkey/ic10-lint": "^1.0.2",
		"@types/node": "^26.2.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=24"
	}
}
