{
	"version": "0.2.0",
	"configurations": [
		{
			// Work on the extension: opens a second VS Code window running it from source.
			"name": "Run the IC10 Test extension",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/ic10-test-vscode"],
			"outFiles": ["${workspaceFolder}/ic10-test-vscode/dist/**/*.cjs"],
			"preLaunchTask": "build the IC10 Test extension"
		},
		{
			// Needs the extension installed (or the window opened by the configuration above).
			"name": "Debug IC10 in the current test file",
			"type": "ic10-test",
			"request": "launch",
			"test": "${file}"
		}
	]
}
