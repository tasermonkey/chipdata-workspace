{
	"version": "0.2.0",
	"configurations": [
		{
			// Needs the IC10 Bench extension (tasermonkey.ic10-bench).
			"name": "Debug IC10 in the current test file",
			"type": "ic10-bench",
			"request": "launch",
			"test": "${file}"
		},
		{
			// As above, with breakpoints in the test's TypeScript too (the setting ic10-bench.debugTypeScript
			// does the same for the CodeLens).
			"name": "Debug IC10 and TypeScript in the current test file",
			"type": "ic10-bench",
			"request": "launch",
			"test": "${file}",
			"debugTypeScript": true
		},
		{
			// No test: the open world module (x.world.ts) or env JSON, or the one beside the open .ic10.
			"name": "Debug the IC10 scenario in the current file",
			"type": "ic10-bench",
			"request": "launch",
			"scenario": "${file}"
		}
	]
}
