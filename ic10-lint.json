{
	"$schema": "./node_modules/@tasermonkey/ic10-lint/schema.json",
	"dir": "ic10",
	"rules": {
		"max-lines": "error",
		"max-columns": "error",
		"max-bytes": "error",
		"validate": "error",
		"batch-ops": "error",
		"hash-name": "error",
		"relative-branch-to-label": "warn",
		"absolute-jump-number": "warn",
		"unused": "warn",
		"register-flow": "off",
		"idle": "error"
	},
	"overrides": {
		"ic10/FurnaceControl/Arc Furnace.ic10": {
			"reason": "Staying for documentation, and the script has room",
			"rules": {
				"unused": "off"
			}
		}
	}
}
